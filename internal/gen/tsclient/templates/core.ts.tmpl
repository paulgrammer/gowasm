// Code generated by gowasm. DO NOT EDIT.

/** An error raised inside the Go program and forwarded across the boundary. */
export class GoError extends Error {
  constructor(message: string, options?: { cause?: unknown }) {
    super(message, options);
    this.name = "GoError";
  }
}

export interface LoadOptions {
  /** Where to fetch the module from. Defaults to main.wasm beside this file. */
  wasmUrl?: string | URL;
  /** Pre-read bytes, for callers that manage the asset themselves. */
  wasmBytes?: BufferSource;
  /** A compiled module, to instantiate many times without recompiling. */
  module?: WebAssembly.Module;
  /** Environment exposed to the Go program via os.Getenv. */
  env?: Record<string, string>;
}

/** A booted Go instance. One per WebAssembly instance, not shared. */
export interface Instance {
  call<T>(name: string, args: unknown[]): Promise<T>;
  dispose(): Promise<void>;
}

export type Loader = (opts: LoadOptions) => Promise<WebAssembly.Module>;

interface Namespace {
  [name: string]: (payload: string) => Promise<string>;
}

// The Go side calls this once its exports are installed. go.run()'s promise
// resolves when main() *exits*, so it is useless as a readiness signal; without
// this handshake the first call races registration.
const pending = new Map<string, () => void>();

function armReady(): void {
  const g = globalThis as Record<string, unknown>;
  if (typeof g.__gowasmReady === "function") return;
  g.__gowasmReady = (id: string) => {
    const resolve = pending.get(id);
    if (resolve) {
      pending.delete(id);
      resolve();
    }
  };
}

let seq = 0;

export async function createInstance(
  loader: Loader,
  namespace: string,
  opts: LoadOptions = {},
): Promise<Instance> {
  const module = await loader(opts);

  armReady();
  const id = `__gowasm_${namespace}_${seq++}`;
  const ready = new Promise<void>((resolve) => pending.set(id, resolve));

  const go = new Go();
  // argv[1] is the namespace the Go side installs itself under. Every instance
  // gets its own, because js.Global().Set writes the real global object and two
  // instances would otherwise overwrite each other.
  go.argv = ["main.wasm", id];
  if (opts.env) go.env = { ...go.env, ...opts.env };

  const instance = await WebAssembly.instantiate(module, go.importObject);

  // Deliberately not awaited: this settles only when the Go program exits.
  const exited = go.run(instance);

  await Promise.race([
    ready,
    exited.then(() => {
      pending.delete(id);
      throw new GoError("the Go program exited before it finished starting up");
    }),
  ]);

  const ns = (globalThis as unknown as Record<string, Namespace>)[id];
  if (!ns) throw new GoError(`Go instance ${id} did not install its exports`);

  let disposed = false;

  return {
    async call<T>(name: string, args: unknown[]): Promise<T> {
      if (disposed) {
        throw new GoError(`${name}: this instance has been disposed`);
      }
      // JSON.stringify turns undefined into null, which Go would then decode
      // into a zero value: a forgotten argument would silently become "" or 0.
      // No generated parameter is optional, so undefined is always a mistake.
      for (let i = 0; i < args.length; i++) {
        if (args[i] === undefined) {
          throw new GoError(
            `${name}: argument ${i + 1} is undefined; pass a value or null`,
          );
        }
      }

      let raw: string;
      try {
        raw = await ns[name](JSON.stringify(args));
      } catch (cause) {
        throw asGoError(cause);
      }
      // A function with no results resolves with the empty string.
      return (raw === "" ? undefined : JSON.parse(raw)) as T;
    },

    async dispose(): Promise<void> {
      if (disposed) return;
      disposed = true;
      ns.dispose("");
      await exited;
      cancelPendingTimers(go);
    },
  };
}

// The Go runtime schedules setTimeout callbacks through wasm_exec.js, which
// tracks them in a map but does not clear them when the program exits. A timer
// still pending at that point fires into a torn-down instance and throws
// "Go program has already exited" as an unhandled exception.
//
// The stock Node driver never sees this because it exits the process outright;
// an instance that can be disposed and outlived does. Nothing in the public
// surface exposes those handles, so they are cleared directly.
function cancelPendingTimers(go: Go): void {
  const pendingTimers = (
    go as unknown as {
      _scheduledTimeouts?: Map<number, ReturnType<typeof setTimeout>>;
    }
  )._scheduledTimeouts;
  if (!pendingTimers) return;
  for (const handle of pendingTimers.values()) clearTimeout(handle);
  pendingTimers.clear();
}

/**
 * Runs one bound call, turning anything it throws into a GoError.
 *
 * Argument conversion happens before the call reaches the instance, so a bad
 * argument would otherwise surface as a raw TypeError from inside the codec
 * rather than as the GoError every other failure produces. Every rejection
 * from this API is a GoError, and this is what makes that true.
 */
export async function guard<T>(name: string, run: () => Promise<T>): Promise<T> {
  try {
    return await run();
  } catch (cause) {
    // An error raised by Go already carries its own context and is passed
    // through untouched. Anything else came from this side -- almost always a
    // bad argument failing conversion -- and needs the function name, since a
    // bare "Cannot read properties of undefined" says nothing about where.
    if (cause instanceof GoError) throw cause;
    throw new GoError(`${name}: ${messageOf(cause)}`, { cause });
  }
}

function messageOf(cause: unknown): string {
  return cause instanceof Error ? cause.message : String(cause);
}

function asGoError(cause: unknown): GoError {
  if (cause instanceof GoError) return cause;
  if (cause instanceof Error) {
    const err = new GoError(cause.message, { cause });
    if (cause.stack) err.stack = cause.stack;
    return err;
  }
  return new GoError(String(cause), { cause });
}
