  } finally {
    await client.dispose();
  }
});

test("falls back to compile() when the MIME type is wrong", async () => {
  contentType = "text/plain";
  try {
    const client = await createClient({ wasmUrl: `${base}/main.wasm` });
    try {
      assert.equal(typeof client.{{.First.JSName}}, "function");
    } finally {
      await client.dispose();
    }
  } finally {
    contentType = "application/wasm";
  }
});

test("a missing asset fails with a useful message", async () => {
  await assert.rejects(
