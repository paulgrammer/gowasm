let base: string;
let contentType = "application/wasm";

before(async () => {
  const wasm = await readFile(new URL("../dist/main.wasm", import.meta.url));
  server = createServer((_req, res) => {
    res.setHeader("Content-Type", contentType);
    res.end(wasm);
